# ========== 基础配置 ==========
APP_NAME=衡策
APP_VERSION=0.1.0
DEBUG=true
# 是否打印 SQL 语句（调试用，默认关闭，避免敏感数据落日志）
SQL_ECHO=false
# 本地开发用 SQLite；生产换 PostgreSQL 时改这里：
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/hengce
DATABASE_URL=sqlite+aiosqlite:///./hengce.db

# ========== 安全 ==========
# 生产环境必须替换为 32+ 位随机串（可用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成）
JWT_SECRET_KEY=change-me-in-production-please-use-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=720

# ========== LLM 配置（启用真实 AI 分析） ==========
# 三个 Provider 任选其一；未配置 API Key 时后端自动进入 Mock 模式
#
# 👉 推荐：DeepSeek（新用户注册送 $5 免费额度，性价比最高）
#    注册地址：https://platform.deepseek.com
#    获取 API Key → https://platform.deepseek.com/api_keys
#    常用模型：
#      deepseek-chat  — 主力模型，$0.27/1M input, $1.10/1M output
#      deepseek-flash — 极速模型，$0.07/1M input, $0.28/1M output
#    参考文档：https://api-docs.deepseek.com/zh-cn/
#
# 👉 备选：阿里通义千问（免费额度较多，但国内访问需要实名认证）
#    注册地址：https://dashscope.console.aliyun.com
#
# 👉 备选：OpenAI（国内需代理）
#
LLM_PROVIDER=mock
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_PROVIDER=qwen
# QWEN_API_KEY=sk-xxxxxxxxxx
# QWEN_MODEL=qwen-max
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# ========== 行情 ==========
# A 股数据源：baostock（日线/分钟线）+ 东方财富实时盘口 + akshare（快讯/板块）
# 全部免费、无需注册，无需额外配置

# ========== 到价预警 ==========
ALERT_ENABLED=true
ALERT_POLL_INTERVAL_SECONDS=60
ALERT_TRADING_HOURS_ONLY=true

# ========== 预警邮件推送（可选） ==========
# 不配置则只做站内提醒；SMTP_PORT=465 走 SSL，其他端口走 STARTTLS
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@qq.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=you@qq.com

# ========== 限流 ==========
AGENT_CHAT_RATE_LIMIT=20/minute
MARKET_RATE_LIMIT=60/minute

# ========== 日志 ==========
# 落盘到 backend/logs，按 10MB 轮转、保留 7 天；置空则只输出到终端
LOG_FILE=logs/hengce.log
LOG_LEVEL=INFO

# ========== CORS ==========
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ========== 免责声明 ==========
# Agent 给出的建议仅供参考，不构成投资建议
AGENT_DISCLAIMER="本 AI 助手提供的分析和建议仅供学习参考，不构成任何投资建议。投资有风险，入市需谨慎。"
